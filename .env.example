# Database URL - Get this from your Neon database (https://neon.tech)
# Example: postgresql://user:password@host/database
VITE_DATABASE_URL=

# PartyKit Host - Real-time collaboration server
# For local development: localhost:1999
# For production: your-project.partykit.dev
VITE_PARTYKIT_HOST=tools.oluwasetemi.partykit.dev

# Internal API secret — shared between app and PartyKit for machine-to-machine calls
INTERNAL_API_SECRET=

# App base URL — used by PartyKit to call internal API routes
# Local: http://localhost:3000
# Production: https://your-app.netlify.app
APP_URL=http://localhost:3000

# Resend API Key — Email service for sending certificates
# Get this from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
